{
  "name": "dsh-web-wallpaper",
  "version": "0.2.0",
  "description": "DSH Web UI 壁纸插件 —— 随时更换桌面端背景：本机图片/视频(MP4 动态壁纸)/URL 导入、一键随机、定时轮换、可读性遮罩、界面面板透明化",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "wallpaper",
    "background"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlbbb/dsh-web-wallpaper.git"
  },
  "homepage": "https://github.com/hlbbb/dsh-web-wallpaper#readme",
  "bugs": {
    "url": "https://github.com/hlbbb/dsh-web-wallpaper/issues"
  },
  "author": "hlbbb"
}
